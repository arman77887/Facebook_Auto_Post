# Application Settings
APP_NAME="Facebook Auto Post SaaS"
ENVIRONMENT="production"
LOG_LEVEL="INFO"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
BASE_URL="https://yourdomain.com"

# Database Configuration
POSTGRES_USER="fb_saas_user"
POSTGRES_PASSWORD="SuperSecretPassword123!"
POSTGRES_DB="fb_saas_db"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://fb_saas_user:SuperSecretPassword123!@postgres:5432/fb_saas_db"

# Redis Configuration
REDIS_URL="redis://redis:6379/0"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ"
ADMIN_TELEGRAM_ID=123456789

# Facebook OAuth & Graph API
FACEBOOK_APP_ID="123456789012345"
FACEBOOK_APP_SECRET="abcdef1234567890abcdef1234567890"
FACEBOOK_GRAPH_VERSION="v20.0"
FACEBOOK_VERIFY_TOKEN="YourCustomWebhookVerifyToken123"

# Encryption & Security
ENCRYPTION_KEY="GenerateWithFernetGenerateKeyInPython=="
SECRET_KEY="SuperSecretJWTKeyForFastAPIAndSessionEncryption"

# OpenAI Configuration
OPENAI_API_KEY="sk-proj-YourOpenAIApiKeyHere"
OPENAI_MODEL="gpt-4o-mini"
